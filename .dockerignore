# Keep the build context small and never bake local state or secrets into the image.
.git
.github
.agents
.secrets/
**/.env*
**/node_modules
**/dist
**/.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.vite
**/*.db
**/*.sqlite*
*.tar
*.log
claude-progress.txt
features.json
init.sh
docker-compose.yml
