# Fulwood Forge — Environment Configuration Template
# Copy to .env (chmod 600 .env) and populate required secrets before running docker compose.

# ── Google Gemini API ────────────────────────────────────────────────────────
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ── MySQL 8.4 LTS (InnoDB, utf8mb4_0900_ai_ci) ───────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=fulwood_forge
MYSQL_USER=fulwood_app
MYSQL_PASSWORD=replace-with-strong-mysql-app-password
MYSQL_ROOT_PASSWORD=replace-with-strong-mysql-root-password

# ── Initial Bootstrap Administrator (REQ-ADMIN-01) ───────────────────────────
# BOOTSTRAP_ADMIN_PASSWORD must be at least 12 characters in production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-min-12-char-admin-password

# ── Session & HTTP Hardening (REQ-AUTH-05, REQ-SEC-01) ───────────────────────
SESSION_COOKIE_SECURE=true
SESSION_TTL_HOURS=24
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
SECCOMP_PROFILE_PATH=./deploy/chrome-seccomp.json
